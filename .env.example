# Copy to .env and fill in. Never commit .env.

# Email (Gmail SMTP + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
MAIL_FROM_NAME=InviteFlow
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=

# SMS: twilio | android_smsgate | mock_test
SMS_PROVIDER_MODE=android_smsgate
SMS_GATE_BASE_URL=https://api.sms-gate.app
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
SMS_GATE_DEVICE_ID=
SMS_GATE_WEBHOOK_SECRET=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp: meta | evolution | mock_test
# Evolution TEST: Docker evoapicloud/evolution-api:v2.3.7 on http://127.0.0.1:8081
WHATSAPP_PROVIDER_MODE=meta
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/me/messages
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM_NUMBER=
EVOLUTION_BASE_URL=http://127.0.0.1:8081
EVOLUTION_INSTANCE=inviteflow-test
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# App
APP_PUBLIC_URL=http://localhost:5173
JWT_SECRET=
